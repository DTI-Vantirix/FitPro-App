# Copy to server/.env (or export these) and adjust. Nothing here is a secret
# for local development; production values must never be committed.

# --- API (server/)
DATABASE_URL=postgres://fitpro:fitpro@localhost:5432/fitpro
# Tests use their own database (wiped on every run)
TEST_DATABASE_URL=postgres://fitpro:fitpro@localhost:5432/fitpro_test
PORT=4000
# Required in production: at least 32 random characters (openssl rand -base64 48)
JWT_SECRET=
TOKEN_TTL_DAYS=30
# Web app origin(s) allowed to call the API from a browser, comma separated
CORS_ORIGINS=http://localhost:5173
# Used in password-reset emails
APP_URL=http://localhost:5173
# Public base URL of the API, for upload links. Empty = same origin.
PUBLIC_URL=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
# Email: without a key, emails (codes, reset links) are printed to the API console
RESEND_API_KEY=
MAIL_FROM=FitPro <no-reply@yourdomain.com>
# Route snapping (Valhalla). "off" = straight lines only
ROUTER_URL=https://valhalla1.openstreetmap.de/route
# Set to true only behind a reverse proxy you control
TRUST_PROXY=false
# Serve the built web app from the API process (single-server deploys)
WEB_DIST=

# --- Web (web/)
# Empty in development (Vite proxies /api). In a split deploy, the API's URL.
VITE_API_URL=

# --- Docker (put this one in a .env file next to docker-compose.yml)
# Host port for the dev database. Change it if 5432 is already taken, and use
# the same port in DATABASE_URL and TEST_DATABASE_URL above.
# FITPRO_DB_PORT=5432
