# Copy to server/.env (or export these) and adjust. Nothing here is a secret
# for local development; production values must never be committed.

# --- API (server/)
DATABASE_URL=postgres://fitpro:fitpro@localhost:5432/fitpro
# Tests use their own database (wiped on every run)
TEST_DATABASE_URL=postgres://fitpro:fitpro@localhost:5432/fitpro_test
PORT=4000
# Required in production: at least 32 random characters (openssl rand -base64 48)
JWT_SECRET=
TOKEN_TTL_DAYS=30
# Web app origin(s) allowed to call the API from a browser, comma separated
CORS_ORIGINS=http://localhost:5173
# Used in password-reset emails
APP_URL=http://localhost:5173
# Public base URL of the API, for upload links. Empty = same origin.
PUBLIC_URL=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
# Optional: keep uploads in an S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS S3)
# instead of UPLOAD_DIR. Used only when the first four are all set.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Email: without a key, emails (codes, reset links) are printed to the API console
RESEND_API_KEY=
MAIL_FROM=FitPro <no-reply@yourdomain.com>
# Route snapping (Valhalla). "off" = straight lines only
ROUTER_URL=https://valhalla1.openstreetmap.de/route
# Key for a hosted Valhalla provider (sent as api_key), e.g. with
# ROUTER_URL=https://api.stadiamaps.com/route/v1. Empty = no key.
ROUTER_API_KEY=
# Set to true only behind a reverse proxy you control
TRUST_PROXY=false
# Serve the built web app from the API process (single-server deploys)
WEB_DIST=
# Friend invite links (https://<site>/friends?add=<handle>) that open the phone app. The API
# serves /.well-known/apple-app-site-association and /.well-known/assetlinks.json from these.
# iOS app id(s), <Apple team id>.<bundle id>, comma separated. Empty = LA4YX3HF32.com.vantrarun.app
IOS_APP_ID=
# SHA-256 fingerprint(s) of the Android signing certificate, comma separated (colons optional).
# Empty = assetlinks.json is an empty list and the link opens the website on Android.
ANDROID_CERT_SHA256=
# off (the default): sign-up needs an invite code. on: anyone can create an account;
# one without access (a subscription, an invite code or a free pass) cannot use the
# product. Leave off until payments are built and tested.
SUBSCRIPTIONS=off
# Stripe, for subscriptions bought on the website. All four or none: with any one empty
# nobody can subscribe, and SUBSCRIPTIONS=on only opens sign-up. Use test-mode values
# (sk_test_...) until the whole flow has been tried. See docs/launch-checklist.md.
# Secret key (Stripe dashboard, Developers, API keys)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<site>/api/stripe/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Price id of the $4.99 monthly price (price_...)
STRIPE_PRICE_MONTHLY=
# Price id of the $49.99 yearly price (price_...)
STRIPE_PRICE_ANNUAL=
# First admin on a new host with no shell: created once at start-up if this email has no
# account yet (password of 12+ characters). Never changes an existing account. Remove
# ADMIN_PASSWORD after the first sign-in. Locally, use `npm run create-admin` instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Web (web/)
# Empty in development (Vite proxies /api). In a split deploy, the API's URL.
VITE_API_URL=

# --- Docker (put this one in a .env file next to docker-compose.yml)
# Host port for the dev database. Change it if 5432 is already taken, and use
# the same port in DATABASE_URL and TEST_DATABASE_URL above.
# FITPRO_DB_PORT=5432
