{
  "name": "Workout",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Session name, e.g. Push A \u2014 chest & shoulders"
    },
    "performed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_min": {
      "type": "number"
    },
    "total_volume": {
      "type": "number",
      "description": "Total weight moved in pounds"
    },
    "set_count": {
      "type": "number"
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "muscle": {
            "type": "string"
          },
          "sets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reps": {
                  "type": "number"
                },
                "weight": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Where this workout came from: live, apple, health_connect, garmin, manual"
    },
    "external_id": {
      "type": "string",
      "description": "The session id at the source, used to update a synced workout instead of duplicating it"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}