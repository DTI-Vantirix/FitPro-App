{
  "name": "AccessGrant",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The athlete this access belongs to"
    },
    "email": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "The invite code that unlocked the app"
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}