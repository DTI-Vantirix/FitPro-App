{
  "name": "InviteCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Single-use access code handed out to a tester"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "used",
        "revoked"
      ],
      "enumColors": [
        "green",
        "gray",
        "red"
      ],
      "default": "available"
    },
    "note": {
      "type": "string",
      "description": "Who the code was for, e.g. early testers batch 1"
    },
    "used_by_id": {
      "type": "string"
    },
    "used_by_email": {
      "type": "string"
    },
    "used_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}