{
  "name": "Route",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Route name, e.g. Ironworks loop"
    },
    "distance_mi": {
      "type": "number",
      "description": "Total route distance in miles"
    },
    "points": {
      "type": "array",
      "description": "Ordered waypoints tapped on the map",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        }
      }
    },
    "path": {
      "type": "array",
      "description": "Dense road-following geometry drawn between the waypoints",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        }
      }
    },
    "target_zone_id": {
      "type": "string",
      "description": "Default pace zone id used when this route is run"
    },
    "target_zone_name": {
      "type": "string",
      "description": "Pace zone name at time of setting"
    },
    "gym_stop": {
      "type": "string",
      "description": "Gym visited mid-route, if any"
    },
    "gym_point": {
      "type": "object",
      "description": "Gym location on the route \u2014 the run pauses automatically here",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}